# Postgres
POSTGRES_USER=prf
POSTGRES_PASSWORD=prf
POSTGRES_DB=prf_ai_pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# App runtime uses asyncpg; Alembic migrations use sync psycopg
DATABASE_URL=postgresql+asyncpg://prf:prf@localhost:5432/prf_ai_pipeline
DATABASE_URL_SYNC=postgresql+psycopg://prf:prf@localhost:5432/prf_ai_pipeline

# LangGraph checkpointer connects to the same instance, dedicated schema
CHECKPOINTER_DATABASE_URL=postgresql://prf:prf@localhost:5432/prf_ai_pipeline

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM (provider-agnostic via LangChain init_chat_model).
#
# Ollama is the reference configuration: no API key, no per-call cost, and it's
# what the committed eval baseline was recorded against. Requires a local Ollama
# with the model pulled (`ollama pull qwen2.5:14b`).
#
# Note: Settings' own in-code defaults (core/config.py) are still google_genai —
# these values are what the project actually runs on, so a copied .env wins.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b

# Hosted alternatives — swap LLM_PROVIDER/LLM_MODEL to one of these and fill in
# the matching key. Nothing else in the codebase changes.
#   LLM_PROVIDER=google_genai   LLM_MODEL=gemini-2.5-flash
#   LLM_PROVIDER=anthropic      LLM_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Only needed if LLM_PROVIDER=ollama and you're running the dockerized
# api/celery-worker (docker-compose.yml defaults this to
# http://host.docker.internal:11434 for you). Leave unset for a bare
# `uv run` against a local Ollama on the host — ChatOllama's own
# http://localhost:11434 default is already correct there.
OLLAMA_BASE_URL=

# LLM-as-judge model used by the evaluation framework. Kept different from
# LLM_MODEL on purpose — a model grading its own output is biased toward it.
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.1:8b

# Embeddings for campaign-knowledge RAG (provider-agnostic via init_embeddings).
# Anthropic has no embeddings API, so this defaults to OpenAI — set the key below.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Comma-separated allowlist for the API's CORS middleware. Defaults to the
# React dashboard's Vite dev server; add the deployed dashboard's origin here
# for anything beyond local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Observability (Phase 8b). docker-compose points both api/celery-worker at
# the bundled Jaeger container's OTLP receiver; a bare `uv run` needs a
# local OTLP endpoint (e.g. `docker compose up -d jaeger`) or traces just
# fail to export -- the app itself doesn't depend on this being reachable.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Port the Celery worker exposes its own Prometheus /metrics on (the API's
# metrics ride its normal port instead -- see main.py).
CELERY_METRICS_PORT=9100

# MCP servers (real streamable-HTTP FastMCP servers, synthetic data behind them)
MCP_CRM_URL=http://localhost:8100/mcp
MCP_ADDRESS_URL=http://localhost:8101/mcp
MCP_COMPLIANCE_URL=http://localhost:8102/mcp
MCP_PRINT_VENDOR_URL=http://localhost:8103/mcp

# App
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD_DONOR_VERIFICATION=0.80
CONFIDENCE_THRESHOLD_ADDRESS_INTELLIGENCE=0.80
# Advisory only (non-blocking). Lower than the factual agents by design — a
# recommendation predicts a future gift rather than assessing a present fact.
CONFIDENCE_THRESHOLD_DONATION_RECOMMENDATION=0.50
# Advisory. Between recommendation and the factual agents: groundedness in
# retrieved knowledge is more concrete than a prediction about a future gift.
CONFIDENCE_THRESHOLD_CAMPAIGN_PERSONALIZATION=0.60
# Advisory. Judging whether already-written text breaks a guideline is closer to
# a factual read, so this sits nearer the factual agents' 0.80.
CONFIDENCE_THRESHOLD_COMPLIANCE=0.75

# The one *blocking* money gate: an ask at or above this pauses for approval.
# Deterministic on purpose — never routed off a model confidence score.
MAJOR_GIFT_ASK_THRESHOLD=1000.0
